	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\le1\OneDrive - INNOGY CZ\Desktop\projects\fabini-publication\exports\fact_sales.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				
				    Headers = Table.PromoteHeaders(
				        Source,
				        [PromoteAllScalars=true]
				    ),
				
				    // DuckDB export: \N represents SQL NULL
				    Nulls = Table.ReplaceValue(
				        Headers,
				        "\N",
				        null,
				        Replacer.ReplaceValue,
				        Table.ColumnNames(Headers)
				    ),
				
				    // Financial columns
				    FinancialColumns = {
				        "unit_cost_czk",
				        "gross_sales_czk",
				        "discounts_czk",
				        "net_sales_czk",
				        "cogs_czk",
				        "gross_margin_czk"
				    },
				
				    FinancialTypes = List.Transform(
				        FinancialColumns,
				        each {_, Currency.Type}
				    ),
				
				    // Other data types
				    OtherTypes = {
				        {"shop", type text},
				        {"reporting_date", type date},
				        {"reporting_month", type text},
				        {"order_id", type text},
				        {"line_id", type text},
				        {"source_sku", type text},
				        {"sku", type text},
				        {"product_name", type text},
				        {"category", type text},
				        {"product_match_status", type text},
				        {"customer_id", type text},
				        {"currency", type text},
				        {"fx_rate_date", type date},
				        {"fx_rate", type number},
				        {"created_at", type datetimezone},
				        {"source_line_quantity", Int64.Type},
				        {"bundle_component_quantity", Int64.Type},
				        {"sold_quantity", Int64.Type},
				        {"is_bundle_component", type logical},
				        {"component_ordinal", Int64.Type}
				    },
				
				    // Apply column types
				    Typed = Table.TransformColumnTypes(
				        Nulls,
				        List.Combine({OtherTypes, FinancialTypes}),
				        "en-US"
				    ),
				
				    // Replace missing category and product names with explicit labels
				    ProductLabels = Table.TransformColumns(
				        Typed,
				        {
				            {
				                "category",
				                each
				                    if _ = null or Text.Trim(_) = ""
				                    then "Unknown"
				                    else _,
				                type text
				            },
				            {
				                "product_name",
				                each
				                    if _ = null or Text.Trim(_) = ""
				                    then "Unknown Product"
				                    else _,
				                type text
				            }
				        }
				    ),
				
				    // Monthly key for relationships and filtering
				    MonthDateKey = Table.AddColumn(
				        ProductLabels,
				        "MonthDateKey",
				        each Date.StartOfMonth([reporting_date]),
				        type date
				    )
				in
				    MonthDateKey

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

