	partition raw_budget = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\le1\OneDrive - INNOGY CZ\Desktop\projects\fabini-publication\raw_data\raw_budget.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				
				    Typed = Table.TransformColumnTypes(
				        Headers,
				        {
				            {"month", type text},
				            {"shop", type text},
				            {"orders_budget", Int64.Type},
				            {"net_sales_czk_budget", Currency.Type}
				        },
				        "en-US"
				    ),
				
				    MonthDateKey = Table.AddColumn(
				        Typed,
				        "MonthDateKey",
				        each Date.FromText([month] & "-01", [Format="yyyy-MM-dd", Culture="en-US"]),
				        type date
				    )
				in
				    MonthDateKey

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

