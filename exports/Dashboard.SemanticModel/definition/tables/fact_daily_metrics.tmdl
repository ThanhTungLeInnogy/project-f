	partition fact_daily_metrics = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\le1\OneDrive - INNOGY CZ\Desktop\projects\fabini-publication\exports\fact_daily_metrics.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				
				    Headers = Table.PromoteHeaders(
				        Source,
				        [PromoteAllScalars=true]
				    ),
				
				    // Convert DuckDB NULL token to actual null
				    Nulls = Table.ReplaceValue(
				        Headers,
				        "\N",
				        null,
				        Replacer.ReplaceValue,
				        Table.ColumnNames(Headers)
				    ),
				
				    // Financial columns in CZK
				    FinancialColumns = List.Select(
				        Table.ColumnNames(Nulls),
				        each Text.EndsWith(_, "_czk")
				    ),
				
				    FinancialTypes = List.Transform(
				        FinancialColumns,
				        each {_, Currency.Type}
				    ),
				
				    // Other column types
				    OtherTypes = {
				        {"reporting_date", type date},
				        {"reporting_month", type text},
				        {"shop", type text},
				        {"unknown_cost_line_count", Int64.Type},
				        {"gross_margin_pct", type number},
				        {"order_count", Int64.Type}
				    },
				
				    Typed = Table.TransformColumnTypes(
				        Nulls,
				        List.Combine({OtherTypes, FinancialTypes}),
				        "en-US"
				    ),
				
				    // First day of reporting month for dimension relationships
				    MonthDateKey = Table.AddColumn(
				        Typed,
				        "MonthDateKey",
				        each Date.StartOfMonth([reporting_date]),
				        type date
				    )
				in
				    MonthDateKey

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

