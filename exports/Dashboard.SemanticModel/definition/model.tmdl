model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: cs-CZ
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_daily_metrics","fact_sales","raw_budget","calendar","dim_shop"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table fact_daily_metrics
ref table fact_sales
ref table raw_budget
ref table calendar
ref table dim_shop
ref table _measures

ref cultureInfo en-US

